// Cloudflare Workers config: the site is static, so the Worker only serves the built files in dist/.
{
  "name": "portfolio",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist"
  },
  // Needed by `wrangler preview`, which builds the dev branch at dev-portfolio.*.workers.dev
  "previews": {}
}
