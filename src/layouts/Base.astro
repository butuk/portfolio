---
import '../styles/global.css';
import { site } from '../site';
const { title = `${site.name}, designer`, description = 'Senior designer who makes dense information easy to absorb.', bodyClass } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
      // A new accent on every load: OKLCH with fixed lightness 0.7 and chroma 0.11, random hue.
      // Browsers without OKLCH keep the default accent from the stylesheet.
      if (CSS.supports('color', 'oklch(0.7 0.11 0)')) {
        document.documentElement.style.setProperty('--accent', `oklch(0.7 0.11 ${Math.floor(Math.random() * 360)})`);
      }
    </script>
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/og.jpg', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class={bodyClass}>
    <header class="site-header">
      <div class="wrap">
        <a class="name" href="/">{site.name}<span class="title"> • Senior UX / UI / Product Designer</span></a>
        <nav aria-label="Main">
          <a href={site.cv} class="hide-sm">CV</a>
          <a href={site.linkedin} class="hide-sm">LinkedIn</a>
          <a href={`mailto:${site.email}`} class="hide-sm">Email</a>
          <a class="btn btn--accent" href={site.calendly}>Book a call</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <section class="contact wrap" aria-labelledby="contact-title">
      <h2 id="contact-title">Senior UX / UI / Product Designer in Kraków. Open to Work</h2>
      <p>I'm open to full-time roles, in the office or hybrid. A short conversation is the quickest way to see if we fit.</p>
      <div class="actions">
        <a class="btn btn--accent" href={site.calendly}>Book a call</a>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={site.phoneHref}>{site.phone}</a>
      </div>
    </section>
    <footer class="site-footer wrap">© {new Date().getFullYear()} {site.name} · <button type="button" class="linkish" data-consent-open>Cookie settings</button></footer>
    <div class="consent" role="region" aria-label="Cookie consent" hidden>
      <p>I use Google Analytics cookies to see how visitors use this site. Nothing is collected until you agree.</p>
      <div class="consent__actions">
        <button type="button" class="btn btn--small" data-consent="denied">Reject</button>
        <button type="button" class="btn btn--small btn--accent" data-consent="granted">Accept</button>
      </div>
    </div>
    <script>
      // Google Analytics (GA4) loads only after the visitor accepts cookies; the choice is remembered.
      const GA_ID = 'G-WPTZQMD0ZG';
      const KEY = 'consent-analytics';
      const banner = document.querySelector<HTMLElement>('.consent')!;
      const read = () => { try { return localStorage.getItem(KEY); } catch { return null; } };
      const save = (v: string) => { try { localStorage.setItem(KEY, v); } catch {} };
      let loaded = false;
      const w = window as any;
      const loadGA = () => {
        if (loaded) return;
        loaded = true;
        w.dataLayer = w.dataLayer || [];
        w.gtag = function () { w.dataLayer.push(arguments); };
        w.gtag('js', new Date());
        w.gtag('config', GA_ID);
        const sc = document.createElement('script');
        sc.async = true;
        sc.src = `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`;
        document.head.append(sc);
      };
      const choice = read();
      if (choice === 'granted') loadGA();
      else if (choice !== 'denied') banner.hidden = false;
      banner.addEventListener('click', (e) => {
        const v = (e.target as HTMLElement).closest<HTMLElement>('[data-consent]')?.dataset.consent;
        if (!v) return;
        save(v);
        banner.hidden = true;
        if (v === 'granted') loadGA();
        else if (loaded) location.reload();  // withdraw: reload without analytics
      });
      document.querySelector('[data-consent-open]')?.addEventListener('click', () => { banner.hidden = false; });
      // Count clicks on "Book a call" as an event (only when analytics is on).
      document.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement).closest('a[href*="calendly.com"]');
        if (a && loaded) w.gtag('event', 'book_call', { link_url: (a as HTMLAnchorElement).href });
      });
    </script>
    <dialog class="lightbox" aria-label="Enlarged image">
      <button class="btn close" type="button">Close</button>
      <img alt="" />
    </dialog>
    <script>
      const dlg = document.querySelector<HTMLDialogElement>('.lightbox')!;
      const big = dlg.querySelector('img')!;
      document.addEventListener('click', (e) => {
        const btn = (e.target as Element).closest<HTMLButtonElement>('.zoom');
        if (btn) {
          big.src = btn.dataset.full!;
          big.alt = btn.querySelector('img')?.alt ?? '';
          dlg.showModal();
        } else if (dlg.open && (e.target as Element).closest('.lightbox')) {
          dlg.close();
        }
      });
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.querySelectorAll('video[autoplay]').forEach((v) => { (v as HTMLVideoElement).pause(); (v as HTMLVideoElement).controls = true; });
      }
    </script>
  </body>
</html>
