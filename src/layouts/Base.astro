---
import '../styles/global.css';
import { site } from '../site';
const { title = `${site.name}, designer`, description = 'Senior designer who makes dense information easy to absorb.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/og.jpg', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="name" href="/">{site.name}<span class="title"> • Senior UX / UI / Product Designer</span></a>
        <nav aria-label="Main">
          <a href={site.cv} class="hide-sm">CV</a>
          <a href={site.linkedin} class="hide-sm">LinkedIn</a>
          <a href={`mailto:${site.email}`} class="hide-sm">Email</a>
          <a class="btn btn--accent" href={site.calendly}>Let's talk</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <section class="contact wrap" aria-labelledby="contact-title">
      <h2 id="contact-title">Senior UX / UI / Product Designer in Kraków • open to work</h2>
      <p>I'm open to full-time roles, in the office or hybrid. A short conversation is the quickest way to see if we fit.</p>
      <div class="actions">
        <a class="btn btn--accent" href={site.calendly}>Let's talk</a>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={site.phoneHref}>{site.phone}</a>
      </div>
    </section>
    <footer class="site-footer wrap">© {new Date().getFullYear()} {site.name}</footer>
    <dialog class="lightbox" aria-label="Enlarged image">
      <button class="btn close" type="button">Close</button>
      <img alt="" />
    </dialog>
    <script>
      const dlg = document.querySelector<HTMLDialogElement>('.lightbox')!;
      const big = dlg.querySelector('img')!;
      document.addEventListener('click', (e) => {
        const btn = (e.target as Element).closest<HTMLButtonElement>('.zoom');
        if (btn) {
          big.src = btn.dataset.full!;
          big.alt = btn.querySelector('img')?.alt ?? '';
          dlg.showModal();
        } else if (dlg.open && (e.target as Element).closest('.lightbox')) {
          dlg.close();
        }
      });
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.querySelectorAll('video[autoplay]').forEach((v) => { (v as HTMLVideoElement).pause(); (v as HTMLVideoElement).controls = true; });
      }
    </script>
  </body>
</html>
