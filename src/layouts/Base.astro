---
import '../styles/global.css';
import { site } from '../site';
import { ui, langOf, pathIn, localPath, langs } from '../i18n';
const lang = langOf(Astro.url.pathname);
const t = ui[lang];
const { title = t.title, description = t.description, bodyClass, bodyStyle, missingIn = [] } = Astro.props as { title?: string; description?: string; bodyClass?: string; bodyStyle?: string; missingIn?: string[] };
// The same page in each language; a language this page doesn't exist in yet links to that language's main page.
const alt = (l: (typeof langs)[number]) => (missingIn.includes(l) ? localPath(l, '/') : pathIn(Astro.url.pathname, l));
const altLangs = langs.filter((l) => !missingIn.includes(l));
const home = localPath(lang, '/');
const abs = (p: string) => new URL(p, Astro.site).href;
---
<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Colour Safari (and mobile browsers) give their toolbar; without it Safari samples the page background. -->
    <meta name="theme-color" content="#ffffff" />
    {lang === 'en' && !missingIn.includes('pl') && (
      <script is:inline>
        // A visitor whose browser is set to Polish lands on the Polish version, unless they have picked a language
        // with the switcher before. The page stays hidden for the moment it takes, so English never flashes.
        (function () {
          var choice = null;
          try { choice = localStorage.getItem('lang-choice'); } catch (e) {}
          var first = (navigator.languages && navigator.languages[0]) || navigator.language || '';
          if (choice || !/^pl\b/i.test(first)) return;
          document.documentElement.style.visibility = 'hidden';
          document.addEventListener('DOMContentLoaded', function () {
            var pl = document.querySelector('.site-footer .lang a[hreflang="pl"]');
            if (pl) location.replace(pl.href + location.search + location.hash);
            else document.documentElement.style.visibility = '';
          });
          setTimeout(function () { document.documentElement.style.visibility = ''; }, 3000);
        })();
      </script>
    )}
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/og.jpg', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:locale" content={t.ogLocale} />
    {altLangs.length > 1 && altLangs.map((l) => <link rel="alternate" hreflang={l} href={abs(pathIn(Astro.url.pathname, l))} />)}
    {altLangs.length > 1 && <link rel="alternate" hreflang="x-default" href={abs(pathIn(Astro.url.pathname, 'en'))} />}
  </head>
  <body class={bodyClass} style={bodyStyle}>
    <header class="site-header">
      <div class="wrap">
        <a class="name" href={home} aria-current={Astro.url.pathname === home ? 'page' : undefined}>{site.name}<span class="title"> • Senior UX / UI / Product Designer</span></a>
        <nav aria-label={t.navLabel}>
          <a href={`${home}#work`}>{t.works}</a>
          <a href={site.cv} class="hide-sm">{t.cv}</a>
          <a href={site.linkedin} class="hide-sm">LinkedIn</a>
          <a href={`mailto:${site.email}`} class="hide-sm">{t.email}</a>
          <a class="btn btn--primary" href={site.calendly}>{t.bookCall}</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <section class="contact wrap" aria-labelledby="contact-title">
      <h2 id="contact-title">{t.contactTitle}</h2>
      <p>{t.contactText}</p>
      <div class="actions">
        <a class="btn btn--primary" href={site.calendly}>{t.bookCall}</a>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={site.phoneHref}>{site.phone}</a>
      </div>
    </section>
    <footer class="site-footer wrap">
      <span>© {new Date().getFullYear()} {site.name}<span class="cookie-settings"> · <button type="button" class="linkish" data-consent-open>{t.cookieSettings}</button></span></span>
      <nav class="lang" aria-label={t.langLabel}>
        {langs.map((l) => <a href={alt(l)} hreflang={l} lang={l} aria-current={l === lang ? 'page' : undefined}>{l.toUpperCase()}</a>)}
      </nav>
      <script is:inline>
        // A language picked with the switcher is remembered, so the automatic choice never overrides it.
        document.querySelectorAll('.site-footer .lang a').forEach(function (a) {
          a.addEventListener('click', function () { try { localStorage.setItem('lang-choice', a.getAttribute('hreflang')); } catch (e) {} });
        });
      </script>
    </footer>
    <div class="consent" role="region" aria-label={t.cookieRegion} hidden>
      <p>{t.cookieText}</p>
      <div class="consent__actions">
        <button type="button" class="btn btn--small" data-consent="denied">{t.reject}</button>
        <button type="button" class="btn btn--small btn--primary" data-consent="granted">{t.accept}</button>
      </div>
    </div>
    <script>
      // Google Analytics (GA4) loads only after the visitor accepts cookies; the choice is remembered.
      const GA_ID = 'G-WPTZQMD0ZG';
      const KEY = 'consent-analytics';
      const banner = document.querySelector<HTMLElement>('.consent')!;
      // While the banner shows, the page gets room for it at the bottom, so it never covers the footer.
      new ResizeObserver(() => document.documentElement.style.setProperty('--consent-h', `${banner.offsetHeight}px`)).observe(banner);
      const read = () => { try { return localStorage.getItem(KEY); } catch { return null; } };
      const save = (v: string) => { try { localStorage.setItem(KEY, v); } catch {} };
      let loaded = false;
      const w = window as any;
      const loadGA = () => {
        if (loaded) return;
        loaded = true;
        w.dataLayer = w.dataLayer || [];
        w.gtag = function () { w.dataLayer.push(arguments); };
        w.gtag('js', new Date());
        w.gtag('config', GA_ID);
        const sc = document.createElement('script');
        sc.async = true;
        sc.src = `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`;
        document.head.append(sc);
      };
      const choice = read();
      if (choice === 'granted') loadGA();
      else if (choice !== 'denied') banner.hidden = false;
      banner.addEventListener('click', (e) => {
        const v = (e.target as HTMLElement).closest<HTMLElement>('[data-consent]')?.dataset.consent;
        if (!v) return;
        save(v);
        banner.hidden = true;
        if (v === 'granted') loadGA();
        else if (loaded) location.reload();  // withdraw: reload without analytics
      });
      document.querySelector('[data-consent-open]')?.addEventListener('click', () => { banner.hidden = false; });
      // Count clicks on "Book a call" as an event (only when analytics is on).
      document.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement).closest('a[href*="calendly.com"]');
        if (a && loaded) w.gtag('event', 'book_call', { link_url: (a as HTMLAnchorElement).href });
      });
    </script>
    <dialog class="lightbox" aria-label={t.enlarged}>
      <button class="btn close" type="button">{t.close}</button>
      <img alt="" />
    </dialog>
    <script>
      const dlg = document.querySelector<HTMLDialogElement>('.lightbox')!;
      const big = dlg.querySelector('img')!;
      document.addEventListener('click', (e) => {
        const btn = (e.target as Element).closest<HTMLButtonElement>('.zoom');
        if (btn) {
          big.src = btn.dataset.full!;
          big.alt = (btn.querySelector('img.is-on') ?? btn.querySelector('img'))?.alt ?? '';
          dlg.showModal();
        } else if (dlg.open && (e.target as Element).closest('.lightbox')) {
          dlg.close();
        }
      });
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.querySelectorAll('video[autoplay]').forEach((v) => { (v as HTMLVideoElement).pause(); (v as HTMLVideoElement).controls = true; });
      }
    </script>
  </body>
</html>
