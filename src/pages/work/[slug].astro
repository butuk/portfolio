---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { nb } from '../../lib/nbsp.mjs';
export async function getStaticPaths() {
  const cases = await getCollection('cases');
  return cases.filter((c) => c.data.format !== 'playground').map((c) => ({ params: { slug: c.id }, props: { entry: c } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---
<Base title={`${d.title}, Vitali Yanusheuski`} description={d.summary} bodyClass="tinted">
  <article>
    <header class="case-head wrap">
      <p class="client">{d.client}, {d.year}</p>
      <h1>{d.title}</h1>
      <p class="lead">{nb(d.summary)}</p>
      <dl class="facts">
        <div><dt>Role</dt><dd>{d.role}</dd></div>
        {d.team && <div><dt>Team</dt><dd>{nb(d.team)}</dd></div>}
        <div><dt>Year</dt><dd>{d.year}</dd></div>
      </dl>
      <ul class="metrics">{d.metrics.map((m) => <li><b>{m.value}</b><span>{nb(m.label)}</span></li>)}</ul>
    </header>
    <div class="prose wrap"><Content /></div>
  </article>
  <script>
    // Equal gaps between fact blocks: the second block starts where the article text starts.
    const facts = document.querySelector<HTMLElement>('.facts');
    const text = document.querySelector<HTMLElement>('.prose > p');
    const fit = () => {
      if (!facts || !text || facts.children.length < 2) return;
      facts.style.removeProperty('--facts-gap');
      const first = facts.children[0].getBoundingClientRect();
      const gap = text.getBoundingClientRect().left - first.right;
      if (gap > 24) facts.style.setProperty('--facts-gap', `${gap}px`);
    };
    fit();
    addEventListener('resize', fit);

    // Trial: the page background moves through Vitali's six colours, red to green, as you scroll.
    const stops = ['#ec623f', '#e67d2f', '#f2ab45', '#e5d245', '#c6c856', '#5db366']
      .map((h) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16)));
    const paint = () => {
      const max = document.documentElement.scrollHeight - innerHeight;
      const t = max > 0 ? Math.min(1, Math.max(0, scrollY / max)) : 0;
      const x = t * (stops.length - 1);
      const i = Math.min(stops.length - 2, Math.floor(x));
      const f = x - i;
      const c = stops[i].map((v, k) => Math.round(v + (stops[i + 1][k] - v) * f));
      const rgb = `rgb(${c.join(' ')})`;
      document.body.style.backgroundColor = rgb;
      document.documentElement.style.backgroundColor = rgb;
    };
    let queued = false;
    const onScroll = () => { if (!queued) { queued = true; requestAnimationFrame(() => { queued = false; paint(); }); } };
    paint();
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
  </script>
</Base>
