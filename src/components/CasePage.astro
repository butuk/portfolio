---
// A case page; the same for every language (the entry comes from that language's collection).
import { render, getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { nb } from '../lib/nbsp.mjs';
import { ui, type Lang } from '../i18n';
const { entry, lang = 'en' } = Astro.props as { entry: any; lang?: Lang };
const t = ui[lang];
const { Content } = await render(entry);
const d = entry.data;
// Languages this case isn't translated into yet (the switcher then points to that language's main page).
const ids = { en: (await getCollection('cases')).map((c) => c.id), pl: (await getCollection('casesPl')).map((c) => c.id) };
const missingIn = (['en', 'pl'] as const).filter((l) => !ids[l].includes(entry.id));
---
<Base title={d.seoTitle ?? `${d.title}, Vitali Yanusheuski`} description={(d.seoDescription ?? d.summary).trim()} bodyClass={d.bg ? 'tinted themed' : 'tinted'} bodyStyle={d.bg ? `--case-bg: ${d.bg}; --case-ink: ${d.ink ?? '#ffffff'}` : undefined} missingIn={missingIn}>
  <article>
    <header class="case-head wrap">
      <p class="client">{d.client}, {d.year}</p>
      <h1>{d.title}</h1>
      <p class="lead">{nb(d.summary)}</p>
      <dl class="facts">
        <div><dt>{t.role}</dt><dd>{d.role}</dd></div>
        {d.team && <div><dt>{t.team}</dt><dd>{nb(d.team)}</dd></div>}
        <div><dt>{t.year}</dt><dd>{d.year}</dd></div>
      </dl>
      <ul class="metrics">{d.metrics.map((m) => <li><b>{m.value}</b><span>{nb(m.label)}</span></li>)}</ul>
    </header>
    <div class="prose wrap"><Content /></div>
  </article>
  <script>
    // Equal gaps between fact blocks: the second block starts where the article text starts.
    const facts = document.querySelector<HTMLElement>('.facts');
    const text = document.querySelector<HTMLElement>('.prose > p');
    const fit = () => {
      if (!facts || !text || facts.children.length < 2) return;
      facts.style.removeProperty('--facts-gap');
      const first = facts.children[0].getBoundingClientRect();
      const gap = text.getBoundingClientRect().left - first.right;
      if (gap > 24) facts.style.setProperty('--facts-gap', `${gap}px`);
    };
    fit();
    addEventListener('resize', fit);

    // A case with its own colour keeps that one background; the others move through Vitali's six colours,
    // red to green, as you scroll.
    const fixed = getComputedStyle(document.body).getPropertyValue('--case-bg').trim();
    const stops = ['#ff7655', '#ff9448', '#f2ab45', '#e5d245', '#c6c856', '#5db366']
      .map((h) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16)));
    const paint = () => {
      const max = document.documentElement.scrollHeight - innerHeight;
      const t = max > 0 ? Math.min(1, Math.max(0, scrollY / max)) : 0;
      const x = t * (stops.length - 1);
      const i = Math.min(stops.length - 2, Math.floor(x));
      const f = x - i;
      const c = stops[i].map((v, k) => Math.round(v + (stops[i + 1][k] - v) * f));
      const rgb = `rgb(${c.join(' ')})`;
      document.body.style.backgroundColor = rgb;
      document.documentElement.style.backgroundColor = rgb;
    };
    let queued = false;
    const onScroll = () => { if (!queued) { queued = true; requestAnimationFrame(() => { queued = false; paint(); }); } };
    if (fixed) {
      document.body.style.backgroundColor = fixed;
      document.documentElement.style.backgroundColor = fixed;
    } else {
      paint();
      addEventListener('scroll', onScroll, { passive: true });
      addEventListener('resize', onScroll);
    }
  </script>
</Base>
