---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Figure from './Figure.astro';
import { site } from '../site';
import { nb } from '../lib/nbsp.mjs';
const { role } = Astro.props;
const all = (await getCollection('cases')).sort((a, b) => a.data.order - b.data.order);
const cases = role ? all.filter((c) => c.data.tags.includes(role)) : all;
const main = cases.filter((c) => c.data.format === 'full' || c.data.format === 'medium');
const roleNames = { product: 'Product', ux: 'UX/UI', data: 'Data' } as const;
const lead = role === 'product' ? 'Product designer' : role === 'ux' ? 'UX/UI designer' : role === 'data' ? 'Information designer' : 'Designer';
const linkBase = role ? `?from=${role}` : '';
// Endings of the main headline, shown one after another like a split-flap board. The first one is the default.
const endings = [
  'makes dense information easy to absorb',
  'makes the complex simple',
  'is all about meaning',
  'is Actual Individual',
  'fights entropy',
];
---
<Base>
  <section class="hero wrap">
    <script is:inline>
      // Hide the hero before it is painted so the intro can reveal it; never longer than 4 s.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('intro');
        setTimeout(() => document.documentElement.classList.remove('intro'), 4000);
      }
    </script>
    <div class="photo"><Figure src="/media/site/photo" alt="Vitali Yanusheuski" bare eager sizes="(min-width: 860px) 113px, 80px" /></div>
    <h1>{lead} who <span class="sr-only">{endings[0]}</span><span class="flap" aria-hidden="true" data-endings={JSON.stringify(endings)}>{endings[0]}</span></h1>
    <p class="lede">I turn large volumes of information into clear structures, so people get the most value in the least time and space. 10+ years in product companies, design studios and agencies, now in healthcare AI at Denti.AI. Based in Kraków.</p>
    <div class="actions">
      <a class="btn btn--accent" href={site.calendly}>Book a call</a>
      <a class="btn" href={site.cv}>Download CV</a>
    </div>
  </section>
  <section class="cases wrap" aria-label="Selected work">
    {main.map((c) => (
      <a class="case-card" href={`/work/${c.id}${linkBase}`}>
        <div>
          <ul class="roles">{c.data.tags.map((t) => <li>{roleNames[t]}</li>)}</ul>
          <p class="client">{c.data.client}, {c.data.year}</p>
          <h2>{c.data.title}</h2>
          <p class="summary">{nb(c.data.summary)}</p>
          <ul class="metrics">{c.data.metrics.map((m) => <li><b>{m.value}</b><span>{nb(m.label)}</span></li>)}</ul>
          <span class="more">View case →</span>
        </div>
        <div class="visual">{c.data.cover && <Figure src={c.data.cover} alt={`${c.data.title} preview`} bare sizes="(min-width: 1100px) 640px, 100vw" />}</div>
      </a>
    ))}
  </section>
  <script>
    // Split-flap headline. Letters change strictly left to right, like a departures board:
    // each position flips through a few letters and lands on the new one; positions to its right
    // still show the old ending. It only runs while the headline is on screen, so the page height
    // changes only where the visitor is looking at it.
    const flap = document.querySelector<HTMLElement>('.flap');
    const h1 = flap?.closest('h1');
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (flap && h1 && !still) {
      const endings: string[] = JSON.parse(flap.dataset.endings!);
      const letters = 'abcdefghijklmnopqrstuvwxyz';
      const HOLD = 4000;      // how long an ending stays
      const STAGGER = 40;     // delay between neighbouring positions
      const STEP = 50;        // one flip
      const TURNS = 3;        // intermediate letters per position, the same for all so they finish in order

      let cells: HTMLSpanElement[] = [];
      const cell = () => { const c = document.createElement('span'); flap.append(c); return c; };
      const set = (c: HTMLSpanElement, ch: string, animate = true) => {
        if (ch === ' ') { c.className = 'sp'; c.textContent = ' '; return; }  // a real space, so lines still wrap between words
        c.className = 'ch';
        c.textContent = ch;
        if (animate && ch) { void c.offsetWidth; c.classList.add('flip'); }
      };
      // Replace the plain text with one cell per character.
      const first = flap.textContent!;
      flap.textContent = '';
      cells = [...first].map((ch) => { const c = cell(); set(c, ch, false); return c; });

      const show = (from: string, to: string): Promise<void> => new Promise<void>((done) => {
        const n = Math.max(from.length, to.length);
        while (cells.length < n) { const c = cell(); set(c, '', false); cells.push(c); }
        for (let i = 0; i < n; i++) {
          const a = from[i] ?? '', b = to[i] ?? '';
          const last = i === n - 1;
          if (a === b) { if (last) setTimeout(done, i * STAGGER); continue; }
          // Start the letter from the alphabet position after the old one, as a real flap would.
          let k = letters.indexOf(a.toLowerCase());
          let turns = b === ' ' || b === '' ? 1 : TURNS;
          setTimeout(function tick() {
            if (turns-- > 0) { k = (k + 1) % letters.length; set(cells[i], letters[k < 0 ? 0 : k]); setTimeout(tick, STEP); }
            else { set(cells[i], b); if (last) done(); }
          }, i * STAGGER);
        }
      }).then(() => {
        // Drop cells left over from a longer ending.
        cells = cells.filter((c) => { if (c.textContent === '') { c.remove(); return false; } return true; });
      });

      let visible = false;
      new IntersectionObserver(([e]) => { visible = e.intersectionRatio >= 0.5; }, { threshold: [0, 0.5, 1] }).observe(h1);

      // Height the headline will have with a given ending, measured on an invisible copy placed
      // right where the headline is, so its lines wrap around the photo exactly like the real ones.
      // It is inserted and removed in the same frame, so nothing is ever painted.
      const heightWith = (text: string) => {
        const copy = h1.cloneNode(true) as HTMLElement;
        copy.removeAttribute('style');
        copy.style.visibility = 'hidden';
        const f = copy.querySelector<HTMLElement>('.flap')!;
        f.textContent = text;
        f.style.whiteSpace = 'normal';  // plain text here, so let it wrap at spaces like the letter cells do
        h1.before(copy);
        const hgt = copy.offsetHeight;
        copy.remove();
        return hgt;
      };

      const GLIDE = 450;  // ms
      const glide = (from: number, to: number) => new Promise<void>((done) => {
        h1.style.transition = 'none';
        h1.style.height = `${from}px`;
        if (from === to) { done(); return; }
        void h1.offsetHeight;
        h1.style.transition = `height ${GLIDE}ms cubic-bezier(0.25, 0.7, 0.25, 1)`;
        h1.style.height = `${to}px`;
        setTimeout(done, GLIDE);
      });

      let n = 0;
      const loop = async () => {
        if (visible && !document.hidden) {
          const from = endings[n];
          n = (n + 1) % endings.length;
          // The headline's height glides instead of jumping, so the text below rides along smoothly:
          // it grows before the letters flip if the new ending is taller, and shrinks after they settle
          // if it is shorter. During the flips the height holds the taller of the two.
          const cur = h1.offsetHeight;
          const next = heightWith(endings[n]);
          glide(cur, Math.max(cur, next));
          // Mid-change, an old word tail glued to a new prefix can wrap onto an extra line; that line is
          // clipped (leaving room for descenders) instead of spilling over the text below.
          h1.style.clipPath = 'inset(-0.3em -100vw -0.06em -100vw)';
          await show(from, endings[n]);
          await glide(Math.max(cur, next), next);
          h1.style.transition = '';
          h1.style.height = '';
          h1.style.clipPath = '';
          setTimeout(loop, HOLD);
        } else {
          setTimeout(loop, 500);  // off screen: wait, change nothing
        }
      };
      setTimeout(loop, HOLD);
    }
  </script>
  <script>
    // Intro: the avatar fades in at the left edge of the headline and glides to its place
    // on the right; once it has arrived, the headline, the text and the buttons fade in.
    const root = document.documentElement;
    if (root.classList.contains('intro')) {
      const photo = document.querySelector<HTMLElement>('.hero .photo')!;
      const h1 = document.querySelector<HTMLElement>('.hero h1')!;
      const text = [...document.querySelectorAll<HTMLElement>('.hero h1, .hero .lede, .hero .actions')];
      const dx = h1.getBoundingClientRect().left - photo.getBoundingClientRect().left;
      const FADE = 500, MOVE = 900, EASE = 'cubic-bezier(0.65, 0, 0.35, 1)';
      photo.style.transform = `translateX(${dx}px)`;
      for (const el of [photo, ...text]) el.style.opacity = '0';
      root.classList.remove('intro');
      void photo.offsetWidth;
      photo.style.transition = `opacity ${FADE}ms ease-out`;
      photo.style.opacity = '1';
      const TEXT = 600;
      setTimeout(() => {
        photo.style.transition = `transform ${MOVE}ms ${EASE}`;
        photo.style.transform = '';
        // The text fades in only once the avatar has arrived.
        setTimeout(() => {
          for (const el of text) { el.style.transition = `opacity ${TEXT}ms ease-out`; el.style.opacity = '1'; }
          setTimeout(() => { for (const el of [photo, ...text]) { el.style.transition = ''; el.style.opacity = ''; } }, TEXT);
        }, MOVE);
      }, FADE + 100);
    }
  </script>
</Base>
