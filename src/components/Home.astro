---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Figure from './Figure.astro';
import { site } from '../site';
const { role } = Astro.props;
const all = (await getCollection('cases')).sort((a, b) => a.data.order - b.data.order);
const cases = role ? all.filter((c) => c.data.tags.includes(role)) : all;
const main = cases.filter((c) => c.data.format === 'full' || c.data.format === 'medium');
const roleNames = { product: 'Product', ux: 'UX/UI', data: 'Data' } as const;
const lead = role === 'product' ? 'Product designer' : role === 'ux' ? 'UX/UI designer' : role === 'data' ? 'Information designer' : 'Designer';
const linkBase = role ? `?from=${role}` : '';
// Endings of the main headline, shown one after another like a split-flap board. The first one is the default.
const endings = [
  'makes dense information easy to absorb',
  'makes the complex simple',
  'is all about meaning',
  'is Actual Individual',
  'fights entropy',
];
---
<Base>
  <section class="hero wrap">
    <div class="photo"><Figure src="/media/site/photo" alt="Vitali Yanusheuski" bare eager sizes="(min-width: 860px) 113px, 80px" /></div>
    <h1>{lead} who <span class="sr-only">{endings[0]}</span><span class="flap" aria-hidden="true" data-endings={JSON.stringify(endings)}>{endings[0]}</span></h1>
    <p class="lede">I turn large volumes of information into clear structures, so people get the most value in the least time and space. 10+ years in product companies, design studios and agencies, now in healthcare AI at Denti.AI. Based in Kraków.</p>
    <div class="actions">
      <a class="btn btn--accent" href={site.calendly}>Let's talk</a>
      <a class="btn" href={site.cv}>Download CV</a>
    </div>
  </section>
  <section class="cases wrap" aria-label="Selected work">
    {main.map((c) => (
      <a class="case-card" href={`/work/${c.id}${linkBase}`}>
        <div>
          <ul class="roles">{c.data.tags.map((t) => <li>{roleNames[t]}</li>)}</ul>
          <p class="client">{c.data.client}, {c.data.year}</p>
          <h2>{c.data.title}</h2>
          <p class="summary">{c.data.summary}</p>
          <ul class="metrics">{c.data.metrics.map((m) => <li><b>{m.value}</b><span>{m.label}</span></li>)}</ul>
          <span class="more">View case →</span>
        </div>
        <div class="visual">{c.data.cover && <Figure src={c.data.cover} alt={`${c.data.title} preview`} bare sizes="(min-width: 1100px) 640px, 100vw" />}</div>
      </a>
    ))}
  </section>
  <script>
    // Split-flap headline. Letters change strictly left to right, like a departures board:
    // each position flips through a few letters and lands on the new one; positions to its right
    // still show the old ending. It only runs while the headline is on screen, so the page height
    // changes only where the visitor is looking at it.
    const flap = document.querySelector<HTMLElement>('.flap');
    const h1 = flap?.closest('h1');
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (flap && h1 && !still) {
      const endings: string[] = JSON.parse(flap.dataset.endings!);
      const letters = 'abcdefghijklmnopqrstuvwxyz';
      const HOLD = 4000;      // how long an ending stays
      const STAGGER = 40;     // delay between neighbouring positions
      const STEP = 50;        // one flip
      const TURNS = 3;        // intermediate letters per position, the same for all so they finish in order

      let cells: HTMLSpanElement[] = [];
      const cell = () => { const c = document.createElement('span'); flap.append(c); return c; };
      const set = (c: HTMLSpanElement, ch: string, animate = true) => {
        if (ch === ' ') { c.className = 'sp'; c.textContent = ' '; return; }  // a real space, so lines still wrap between words
        c.className = 'ch';
        c.textContent = ch;
        if (animate && ch) { void c.offsetWidth; c.classList.add('flip'); }
      };
      // Replace the plain text with one cell per character.
      const first = flap.textContent!;
      flap.textContent = '';
      cells = [...first].map((ch) => { const c = cell(); set(c, ch, false); return c; });

      const show = (from: string, to: string) => new Promise<void>((done) => {
        const n = Math.max(from.length, to.length);
        while (cells.length < n) { const c = cell(); set(c, '', false); cells.push(c); }
        for (let i = 0; i < n; i++) {
          const a = from[i] ?? '', b = to[i] ?? '';
          const last = i === n - 1;
          if (a === b) { if (last) setTimeout(done, i * STAGGER); continue; }
          // Start the letter from the alphabet position after the old one, as a real flap would.
          let k = letters.indexOf(a.toLowerCase());
          let turns = b === ' ' || b === '' ? 1 : TURNS;
          setTimeout(function tick() {
            if (turns-- > 0) { k = (k + 1) % letters.length; set(cells[i], letters[k < 0 ? 0 : k]); setTimeout(tick, STEP); }
            else { set(cells[i], b); if (last) done(); }
          }, i * STAGGER);
        }
      }).then(() => {
        // Drop cells left over from a longer ending.
        cells = cells.filter((c) => { if (c.textContent === '') { c.remove(); return false; } return true; });
      });

      let visible = false;
      new IntersectionObserver(([e]) => { visible = e.intersectionRatio >= 0.5; }, { threshold: [0, 0.5, 1] }).observe(h1);

      let n = 0;
      const loop = async () => {
        if (visible && !document.hidden) {
          const from = endings[n];
          n = (n + 1) % endings.length;
          await show(from, endings[n]);
          setTimeout(loop, HOLD);
        } else {
          setTimeout(loop, 500);  // off screen: wait, change nothing
        }
      };
      setTimeout(loop, HOLD);
    }
  </script>
</Base>
